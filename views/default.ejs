<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0"
      name="viewport"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/img/logo.png" />
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/public/styles.css" rel="stylesheet" />
    <title><%= pageTitle %></title>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/">MCMS Demo</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">Events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/docs">Docs</a>
                    </li>
                </ul>
            </div>
            <%
            if (isAuthenticated) { %>
                <div class="dropdown text-end"> <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"> <img src="/public/img/PFP.png" alt="mdo" width="32" height="32" class="rounded-circle"></a>
                    <ul class="dropdown-menu">
                        <li><span class="dropdown-item-text fw-bold">Welcome back <span class="text-success-emphasis "><%= userData.username %></span>!</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <% if (userData?.permsValue !== 0) { %>
                            <li><a class="dropdown-item" href="/admin">Admin Portal</a></li>
                            <li><hr class="dropdown-divider"></li>
                        <% } %>
                        <li><a class="dropdown-item" href="/login/logout">Sign out</a></li>
                    </ul>
                </div>
            <% } else { %>
                <div class="text-end">
                    <a href="/login" class="btn btn-outline-light me-2">Login</a>
                    <a href="/login/register" class="btn btn-warning">Sign Up</a>
                </div>
            <% } %>
        </div>
    </nav>

    <%- include(pagePath) %>

    <div class="container">
        <footer class="py-5">
            <div class="d-flex flex-column flex-sm-row justify-content-between py-4 my-4 border-top">
              <p>© 2025 MCMS. All rights reserved.</p>
            </div>
        </footer>
    </div>
    

    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
