<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Manage Users</h1>
            <p class="text-body-secondary mb-0">Browse user accounts and jump into the full admin profile editor.</p>
        </div>
        <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <% if (statusMessage) { %>
        <div class="alert alert-success" role="alert"><%= statusMessage %></div>
    <% } %>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Actions</th>
                            <% columnNames.forEach(column => { %>
                                <th scope="col"><%= column %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td class="text-nowrap">
                                    <% if (canEditUsers) { %>
                                        <a href="/admin/manageUsers/<%= user.userID %>" type="button" class="btn btn-sm btn-outline-primary">Edit Profile</a>
                                    <% } else { %>
                                        <span class="text-body-secondary small">No edit access</span>
                                    <% } %>
                                </td>
                                <% columnNames.forEach(key => { %>
                                    <td><%= user[key] %></td>
                                <% }) %>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
